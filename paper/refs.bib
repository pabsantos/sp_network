@article{limasantosHowUrbanMobility2019,
  title = {How Do Urban Mobility (Geo)Graph’s Topological Properties Fill a Map?},
  author = {Lima Santos, Leonardo Bacelar and Carvalho, Luiz Max and Seron, Wilson and Coelho, Flávio C. and Macau, Elbert E. and Quiles, Marcos G. and V. Monteiro, Antônio M.},
  date = {2019-12},
  journaltitle = {Applied Network Science},
  shortjournal = {Appl Netw Sci},
  volume = {4},
  number = {1},
  pages = {91},
  issn = {2364-8228},
  doi = {10.1007/s41109-019-0211-7},
  url = {https://appliednetsci.springeropen.com/articles/10.1007/s41109-019-0211-7},
  urldate = {2025-06-01},
  abstract = {Abstract             Urban mobility data are important to areas ranging from traffic engineering to the analysis of outbreaks and disasters. In this paper, we study mobility data from a major Brazilian city from a geographical viewpoint using a Complex Network approach. The case study is based on intra-urban mobility data from the Metropolitan area of Rio de Janeiro (Brazil), presenting more than 480 spatial network nodes. While for the mobility flow data a log-normal distribution outperformed the power law, we also found moderate evidence for scale-free and small word effects in the flow network’s degree distribution. We employ a novel open-source GIS tool to display (geo)graph’s topological properties in maps and observe a strong traffic-topology association and also a fine adjustment for hubs location for different flow threshold networks. In the central commercial area for lower thresholds and in high population residential areas for higher thresholds. This set of results, including statistical, topological and geographical analysis may represent an important tool for policymakers and stakeholders in the urban planning area, especially by the identification of zones with few but strong links in a real data-driven mobility network.},
  langid = {english},
  file = {/Users/pabsantos/Zotero/storage/F2KAWQ7D/Lima Santos et al. - 2019 - How do urban mobility (geo)graph’s topological pro.pdf}
}

